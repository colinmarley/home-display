# ── Calendars ────────────────────────────────────────────────────────────────
# Google Calendar → Settings → "Secret address in iCal format".
# More feeds: GOOGLE_ICAL_URL_2, GOOGLE_ICAL_URL_WORK, …
GOOGLE_ICAL_URL=https://calendar.google.com/calendar/ical/YOUR_CALENDAR_ID/private-XXXX/basic.ics

# iCloud over CalDAV (recommended — all calendars, reliable sync).
# Create an app-specific password at https://account.apple.com → Sign-In and
# Security → App-Specific Passwords. Username is your Apple ID email.
ICLOUD_USERNAME=you@icloud.com
ICLOUD_APP_PASSWORD=abcd-efgh-ijkl-mnop

# Fallback when ICLOUD_* is not set: iCloud published calendar link(s).
# APPLE_ICAL_URL=webcal://p01-caldav.icloud.com/published/2/YOUR_CALENDAR_HASH
# Any other .ics feeds: ICAL_URL, ICAL_URL_2, …

# ── Display ─────────────────────────────────────────────────────────────────
DISPLAY_TZ=America/Los_Angeles
# Locks /admin (settings page). Leave empty to keep it open on the LAN.
ADMIN_PIN=

# ── Weather (no API key needed) ──────────────────────────────────────────────
WEATHER_LAT=37.2519
WEATHER_LON=-121.8694
# Initial source; change it later from /admin.
# open-meteo | open-meteo-gfs | open-meteo-ecmwf | nws
WEATHER_SOURCE=open-meteo

# ── Photos (Immich) ─────────────────────────────────────────────────────────
IMMICH_BASE_URL=http://YOUR_IMMICH_HOST:2283
# Immich → Account Settings → API Keys. Needs album.read + asset.view.
IMMICH_API_KEY=your_immich_api_key_here
# Immich web UI → open album → copy the UUID from the URL
IMMICH_ALBUM_ID=your_album_uuid_here
# Local photo cache cap (MB)
PHOTO_CACHE_MB=1024

# Initial values; adjust later from /admin.
IDLE_TIMEOUT_MINUTES=10
PHOTO_INTERVAL_SECONDS=30
